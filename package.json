{
  "name": "dsh-liquid-glass-input",
  "description": "Liquid Glass input card for the dsh web GUI - kube.io Magnifying Glass SVG refraction with the original coupled-spring press animation and click highlight",
  "version": "1.32.4",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkamkk/dsh-liquid-glass-input.git"
  },
  "homepage": "https://github.com/jkamkk/dsh-liquid-glass-input",
  "bugs": {
    "url": "https://github.com/jkamkk/dsh-liquid-glass-input/issues"
  },
  "author": "jkamkk",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "liquid-glass",
    "ui"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "Apache-2.0"
}